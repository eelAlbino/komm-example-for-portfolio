{
    "name": "portfolio/comment-attachment-archives",
    "type": "project",
    "description": "Comment attachment archives",
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "doctrine/dbal": "3.9.4",
        "intervention/image": "3.11.1",
        "laravel/framework": "9.52.20",
        "orchid/platform": "13.10.0",
        "php-ffmpeg/php-ffmpeg": "1.3.1",
        "php-open-source-saver/jwt-auth": "2.2.2"
    },
    "require-dev": {
        "fakerphp/faker": "1.24.1",
        "mockery/mockery": "1.6.12",
        "nunomaduro/collision": "6.4.0",
        "phpunit/phpunit": "9.6.22"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "orchid/platform"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
